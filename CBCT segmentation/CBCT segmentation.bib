	journal = {Journal of Dentistry},
	author = {Gerhardt, Maurício do Nascimento and Fontenele, Rocharles Cavalcante and Leite, André Ferreira and Lahoud, Pierre and Van Gerven, Adriaan and Willems, Holger and Smolders, Andreas and Beznik, Thomas and Jacobs, Reinhilde},
	month = jul,
	year = {2022},
	keywords = {Deep Learning, Cone-Beam Computed Tomography, Artificial Intelligence, Digital Dentistry, Digital imaging/radiology, Tooth Detection},
	pages = {104139},
	file = {Gerhardt et al. - 2022 - Automated detection and labelling of teeth and small edentulous regions on cone-beam computed tomogr.pdf:files/14220/Gerhardt et al. - 2022 - Automated detection and labelling of teeth and small edentulous regions on cone-beam computed tomogr.pdf:application/pdf},
}

